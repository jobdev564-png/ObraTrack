# Copia este archivo como .env y ajusta los valores.

ENVIRONMENT=development
DEBUG=true

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=obratrack
DB_PASSWORD=obratrack_dev
DB_NAME=obratrack
# Si prefieres una sola cadena de conexión, usa esta variable (tiene prioridad):
# DATABASE_URL=mysql+pymysql://obratrack:obratrack_dev@127.0.0.1:3306/obratrack?charset=utf8mb4

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=720
# Ponlo en false para que nadie más pueda crear cuentas desde la API.
ALLOW_REGISTRATION=true

# Orígenes permitidos por CORS, separados por coma. "*" solo para desarrollo.
CORS_ORIGINS=*

# --- Telemetría ---
# Rechaza fixes (0,0) que el NEO-6M envía antes de tener señal.
TELEMETRY_REJECT_NULL_ISLAND=true
